{
  "name": "codex-dev-flow-repository",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "bun run --cwd plugins/codex-dev-flow build",
    "check": "bun run format:check && bun run lint && bun run lint:type-aware && bun run typecheck:tools && bun run test:tools && bun run --cwd plugins/codex-dev-flow check",
    "check:staged": "bun scripts/check-staged.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --disable-nested-config .",
    "lint:type-aware": "oxlint --disable-nested-config --type-aware .",
    "pack:runtime": "bun run --cwd plugins/codex-dev-flow pack:runtime",
    "prepare": "husky",
    "release": "bun run --cwd plugins/codex-dev-flow release",
    "test:tools": "bun test test/*.test.ts",
    "typecheck:tools": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
