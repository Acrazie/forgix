{
  "name": "forgix-repository",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "plugins/*",
    "site"
  ],
  "scripts": {
    "site:dev": "bun run --cwd site dev",
    "site:check": "bun run --cwd site check",
    "site:build": "bun run --cwd site build",
    "build": "bun run --cwd plugins/forgix build",
    "check": "bun run format:check && bun run lint && bun run lint:type-aware && bun run typecheck:tools && bun run test:tools && bun run --cwd plugins/forgix check",
    "check:staged": "bun scripts/check-staged.ts",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:type-aware": "vp lint --type-aware .",
    "pack:runtime": "bun run --cwd plugins/forgix pack:runtime",
    "prepare": "lefthook install",
    "release": "bun run --cwd plugins/forgix release",
    "test:tools": "bun test test/*.test.ts",
    "typecheck:tools": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/node": "24.13.3",
    "lefthook": "^1.11.3",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0",
    "yaml": "2.9.0"
  }
}
