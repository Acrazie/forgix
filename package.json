{
  "name": "@acrasie/forgix",
  "version": "4.3.2",
  "description": "Portable development workflow plugin for Codex, Claude Code, and Antigravity.",
  "license": "MIT",
  "homepage": "https://entire.com/et/forgix/forgix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acrazie/forgix.git"
  },
  "bugs": {
    "url": "https://entire.com/et/forgix/forgix"
  },
  "keywords": [
    "codex",
    "claude-code",
    "antigravity",
    "workflow",
    "cli",
    "plugin",
    "development"
  ],
  "type": "module",
  "packageManager": "bun@1.4.4",
  "bin": {
    "forgix": "dist/forgix.mjs"
  },
  "files": [
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    "assets/",
    "dist/",
    "docs/adr/0001-hybrid-portable-workflow.md",
    "docs/adr/0002-share-an-invalidable-context-capsule.md",
    "docs/adr/0004-scale-assurance-lanes-by-applicable-risk.md",
    "docs/adr/0006-make-intake-adaptive-user-authoritative-and-token-efficient.md",
    "docs/adr/0007-collect-opt-in-local-benchmark-feedback.md",
    "docs/adr/0008-automate-maintainer-releases-with-an-interactive-bun-workflow.md",
    "docs/adr/0009-separate-intake-decisions-from-shape-discovery.md",
    "docs/adr/0010-choose-quick-or-plan-after-discovery.md",
    "docs/adr/0011-separate-fast-local-and-authoritative-ci-quality-gates.md",
    "docs/adr/0012-use-bun-test-and-require-node-24.md",
    "docs/adr/0013-layer-source-distribution-and-runtime-tests.md",
    "docs/adr/0014-ratchet-source-coverage-with-bun.md",
    "docs/adr/0015-split-fast-and-type-aware-linting.md",
    "docs/adr/0016-use-husky-with-a-tested-bun-staged-file-adapter.md",
    "docs/adr/0017-format-conservatively-with-oxfmt.md",
    "docs/adr/0018-use-a-high-signal-oxlint-policy.md",
    "docs/adr/0019-gate-deterministic-size-and-observe-timing.md",
    "docs/adr/0020-support-linux-and-macos-with-targeted-ci.md",
    "docs/adr/0021-randomize-tests-without-retries.md",
    "docs/adr/0022-use-one-root-bun-workspace.md",
    "docs/adr/0024-make-gate-a-minimal-plan-approval.md",
    "docs/adr/0025-end-the-lifecycle-after-assure.md",
    "docs/adr/0026-keep-intake-product-stable-and-interview-shape-by-dependency.md",
    "docs/adr/0027-add-agentic-project-init-and-versioned-engineering-profiles.md",
    "docs/adr/0028-make-public-documentation-user-first-and-current.md",
    "docs/adr/0029-make-build-a-native-execution-boundary.md",
    "docs/adr/0030-unify-product-domain-and-technical-design-interviews.md",
    "docs/adr/0031-make-assure-the-success-boundary.md",
    "docs/adr/0032-consolidate-development-tooling-with-vite-plus.md",
    "docs/adr/0037-agent-first-plugin-and-harness-bootstrap.md",
    "docs/artifacts.md",
    "docs/assets/diagrams/forgix-workflow-overview-dark.svg",
    "docs/assets/diagrams/forgix-workflow-overview.svg",
    "docs/assets/diagrams/forgix-workflow-shape-gate-dark.svg",
    "docs/assets/diagrams/forgix-workflow-shape-gate.svg",
    "docs/design.md",
    "docs/getting-started.md",
    "docs/lifecycle-contract.md",
    "docs/project-profile-contract.md",
    "docs/runbooks/maintainer-release.md",
    "docs/target-intake-shape-contract.md",
    "docs/glossary/forgix.md",
    "schemas/",
    "skills/",
    "LICENSE",
    "README.md",
    "plugin.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:size": "bun scripts/check-size-budget.ts",
    "pack:runtime": "bun scripts/package-artifact.ts .artifacts/forgix.tgz",
    "release": "bun scripts/release.ts",
    "release:test": "bun test test/integration/release*.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit test/integration",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:runtime": "node --test test/runtime/runtime-smoke.test.mjs",
    "test:coverage": "bun test --coverage test/unit test/integration test/worktree.test.ts",
    "test:randomization": "bun scripts/verify-test-randomization.ts",
    "check": "bun run format:check && bun run lint && bun run lint:type-aware && bun run check:architecture && bun run check:dead-code:gate && bun run check:dupes && bun run check:health && bun run check:golden-rules && bun run typecheck:tools && bun run test:tools && bun run typecheck && bun run build && bun run test:randomization && bun run test:coverage && bun run check:size",
    "check:architecture": "fallow architecture --cycles --boundaries --policy --no-cache --fail-on-parse-error",
    "check:dead-code": "fallow --only dead-code --format json --no-cache --fail-on-parse-error",
    "check:dead-code:gate": "fallow dead-code --fail-on-issues --no-cache --fail-on-parse-error --baseline fallow-baselines/dead-code.json",
    "check:dupes": "fallow dupes --fail-on-issues --no-cache --baseline fallow-baselines/dupes.json",
    "check:health": "fallow health --no-cache --fail-on-parse-error --baseline-mode identity --baseline fallow-baselines/health.json",
    "check:golden-rules": "bun scripts/check-golden-rules.ts",
    "check:diff": "bun scripts/check-diff.ts",
    "report:complexity": "fallow health --report-only --no-cache",
    "report:duplication": "fallow dupes --no-cache",
    "check:base": "bun scripts/check-base-freshness.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "check:staged": "bun scripts/check-staged.ts",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:type-aware": "vp lint --type-aware .",
    "prepare": "bun scripts/prepare-hooks.ts",
    "test:tools": "bun test test/*.test.ts",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "test:hooks": "bun test test/hooks"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0",
    "fallow": "3.43.2",
    "yaml": "2.9.0",
    "@clack/prompts": "1.0.0",
    "@types/bun": "1.3.14",
    "ajv": "8.20.0"
  }
}
