{
  "name": "codex-dev-flow",
  "version": "0.2.0",
  "description": "Portable Codex development workflow plugin.",
  "license": "MIT",
  "homepage": "https://github.com/Acrazie/codex-dev-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acrazie/codex-dev-flow.git",
    "directory": "plugins/codex-dev-flow"
  },
  "bugs": {
    "url": "https://github.com/Acrazie/codex-dev-flow/issues"
  },
  "keywords": [
    "codex",
    "workflow",
    "cli",
    "plugin",
    "development"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "codex-dev-flow": "dist/dev-flow.mjs"
  },
  "files": [
    ".codex-plugin/",
    "dist/",
    "docs/",
    "schemas/",
    "skills/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "baseline:p0": "bun run build && node scripts/generate-p0-baseline.mjs",
    "release": "bun scripts/release.ts",
    "release:test": "bun test test/release.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "bun run typecheck && bun run build && bun run test && bun run release:test",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "devDependencies": {
    "@clack/prompts": "1.0.0",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  }
}
