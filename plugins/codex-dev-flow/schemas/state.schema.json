{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Dev Flow task state V6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "revision",
    "risk",
    "design",
    "configSnapshot",
    "policySnapshot",
    "issues",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "taskId": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "shape": {
      "$ref": "#/$defs/shapeState"
    },
    "contractDigest": {
      "$ref": "#/$defs/text"
    },
    "assurance": {
      "type": "object"
    },
    "design": {
      "type": "object"
    },
    "resumeTo": {
      "$ref": "#/$defs/resumeTarget"
    },
    "configSnapshot": {
      "type": "object"
    },
    "policySnapshot": {
      "type": "object"
    },
    "issues": {
      "type": "array"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/transitionEvent"
          },
          {
            "$ref": "#/$defs/workflowEvent"
          }
        ]
      }
    },
    "historySummary": {
      "$ref": "#/$defs/historySummary"
    },
    "activeArtifact": {
      "$ref": "#/$defs/activeArtifact"
    },
    "activeWorktree": {
      "$ref": "#/$defs/activeWorktree"
    },
    "contextCapsule": {
      "type": "object"
    },
    "routingSnapshot": {
      "type": "object"
    },
    "routingPolicyVersion": {
      "$ref": "#/$defs/text"
    },
    "routingDecisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "intake": {
      "$ref": "#/$defs/intakeState"
    },
    "benchmarkEnabled": {
      "type": "boolean"
    },
    "resumeReason": {
      "$ref": "#/$defs/text"
    },
    "planApproval": {
      "$ref": "#/$defs/planApprovalReceipt"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["resumeTo", "resumeReason"],
        "properties": {
          "resumeTo": {
            "$ref": "#/$defs/resumeTarget"
          },
          "resumeReason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "blocked"
            }
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["resumeTo"]
            },
            {
              "required": ["resumeReason"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_approval"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["contractDigest"],
        "properties": {
          "contractDigest": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "discovering",
              "awaiting_shape_decision",
              "awaiting_profile_choice",
              "planning",
              "awaiting_intake_decision",
              "awaiting_approval",
              "executing",
              "assuring"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["shape"],
        "properties": {
          "shape": {
            "$ref": "#/$defs/shapeState"
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+~=-]*$"
    },
    "status": {
      "enum": [
        "new",
        "intaking",
        "discovering",
        "awaiting_shape_decision",
        "awaiting_profile_choice",
        "planning",
        "awaiting_intake_decision",
        "awaiting_approval",
        "executing",
        "assuring",
        "blocked",
        "cancelled",
        "failed"
      ]
    },
    "resumeTarget": {
      "enum": [
        "intaking",
        "discovering",
        "awaiting_shape_decision",
        "awaiting_profile_choice",
        "planning",
        "awaiting_intake_decision",
        "awaiting_approval",
        "executing",
        "assuring"
      ]
    },
    "historyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "task",
            "shape",
            "artifact",
            "worktree",
            "context-capsule",
            "context",
            "issue",
            "correction",
            "gate",
            "scope",
            "evidence",
            "receipt",
            "command",
            "criterion",
            "decision",
            "policy",
            "config",
            "git",
            "symbol"
          ]
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "fingerprint": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "workflowEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "type", "refs"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string"
        },
        "type": {
          "enum": [
            "task.created",
            "task.blocked",
            "task.resumed",
            "gate.recorded",
            "scope.approved",
            "artifact.recorded",
            "issue.recorded",
            "correction.recorded",
            "context.updated",
            "intake.checkpoint",
            "advance.rejected",
            "intake.reopened",
            "discovery.target_recorded",
            "discovery.evidence_recorded",
            "discovery.completed",
            "profile.choice_requested",
            "profile.choice_recorded",
            "design.question_recorded",
            "design.answer_recorded",
            "design.invalidated",
            "contract.projected",
            "projection.reconciliation_requested",
            "evidence.invalidated",
            "shape.checkpoint",
            "assurance.evidence_recorded",
            "assurance.evidence_invalidated",
            "assurance.issue_resolved",
            "assurance.human_observation_requested",
            "assure.completed"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/historyReference"
          }
        }
      }
    },
    "transitionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "type", "from", "to", "revision", "sourceFingerprint"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string"
        },
        "type": {
          "const": "state.transition"
        },
        "from": {
          "$ref": "#/$defs/status"
        },
        "to": {
          "$ref": "#/$defs/status"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/text"
        },
        "terminalSource": {
          "$ref": "#/$defs/status"
        },
        "terminalResumeTo": {
          "$ref": "#/$defs/resumeTarget"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "guardEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "gateDecision": {
          "$ref": "#/$defs/gateDecision"
        }
      }
    },
    "historySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removedCount",
        "firstSequence",
        "lastSequence",
        "firstAt",
        "lastAt",
        "typeCounts"
      ],
      "properties": {
        "removedCount": {
          "type": "integer",
          "minimum": 1
        },
        "firstSequence": {
          "type": "integer",
          "minimum": 1
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 1
        },
        "firstAt": {
          "type": "string"
        },
        "lastAt": {
          "type": "string"
        },
        "typeCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lastTransition": {
          "type": "object"
        }
      }
    },
    "activeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "ownerRef", "fingerprint"],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "ownerRef": {
          "$ref": "#/$defs/text"
        },
        "fingerprint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "activeWorktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktreeRef", "gitFingerprint"],
      "properties": {
        "worktreeRef": {
          "$ref": "#/$defs/text"
        },
        "gitFingerprint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "intakeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "risk",
        "provenance",
        "technicalUnknowns",
        "decisions",
        "answeredDecisionKeys",
        "invalidations",
        "contradictions",
        "semanticComplete",
        "deterministicComplete",
        "checkpointDue",
        "semanticRetryCount",
        "metrics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "decisions": {
          "type": "array"
        },
        "answeredDecisionKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidations": {
          "type": "array"
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semanticComplete": {
          "type": "boolean"
        },
        "deterministicComplete": {
          "type": "boolean"
        },
        "checkpointDue": {
          "type": "boolean"
        },
        "semanticRetryCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockedReason": {
          "enum": ["semantic_output_invalid", "answer_required"]
        },
        "metrics": {
          "$ref": "#/$defs/intakeMetrics"
        },
        "risk": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceRefs", "capturedAt", "freshnessRefs"],
          "properties": {
            "sourceRefs": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string"
              }
            },
            "capturedAt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "freshnessRefs": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "technicalUnknowns": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "kind", "description", "owner"],
            "properties": {
              "key": {
                "type": "string"
              },
              "kind": {
                "enum": ["code", "dependency", "architecture", "validation", "operations"]
              },
              "description": {
                "type": "string"
              },
              "owner": {
                "const": "shape"
              }
            }
          }
        },
        "activeQuestionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "shapeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "risk",
        "productBaselineRef",
        "discoveryTargets",
        "evidence",
        "sourceFingerprints",
        "technicalDecisions",
        "dependencyGraph",
        "invalidations",
        "budget",
        "semanticRetryCounts",
        "evaluatorReceipts"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "risk": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "productBaselineRef": {
          "$ref": "#/$defs/text"
        },
        "discoveryTargets": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "sourceFingerprints": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "technicalDecisions": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "activeTechnicalDecisionId": {
          "$ref": "#/$defs/text"
        },
        "preparationProfileChoice": {
          "type": "object"
        },
        "contract": {
          "type": "object"
        },
        "projection": {
          "type": "object"
        },
        "dependencyGraph": {
          "type": "object"
        },
        "invalidations": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "budget": {
          "type": "object"
        },
        "semanticRetryCounts": {
          "type": "object"
        },
        "evaluatorReceipts": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "intakeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelCalls",
        "questionsAsked",
        "questionsAvoided",
        "distinctQuestions",
        "recommendationsAccepted",
        "recommendationsModified",
        "zeroQuestionPath",
        "lateReopenings"
      ],
      "properties": {
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "questionsAsked": {
          "type": "integer",
          "minimum": 0
        },
        "questionsAvoided": {
          "type": "integer",
          "minimum": 0
        },
        "distinctQuestions": {
          "type": "integer",
          "minimum": 0
        },
        "recommendationsAccepted": {
          "type": "integer",
          "minimum": 0
        },
        "recommendationsModified": {
          "type": "integer",
          "minimum": 0
        },
        "lateReopenings": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "zeroQuestionPath": {
          "type": "boolean"
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decision",
        "actor",
        "decidedAt",
        "taskId",
        "artifactId",
        "stateRevision",
        "stateFingerprint",
        "contractDigest",
        "receiptDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "decision": {
          "enum": ["approved", "change_requested", "rejected"]
        },
        "actor": {
          "const": "user"
        },
        "decidedAt": {
          "type": "string"
        },
        "taskId": {
          "$ref": "#/$defs/text"
        },
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "stateFingerprint": {
          "$ref": "#/$defs/text"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "instructionRef": {
          "$ref": "#/$defs/ref"
        },
        "receiptDigest": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "planApprovalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decision",
        "actor",
        "decidedAt",
        "taskId",
        "artifactId",
        "stateRevision",
        "stateFingerprint",
        "contractDigest",
        "receiptDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "decision": {
          "const": "approved"
        },
        "actor": {
          "const": "user"
        },
        "decidedAt": {
          "type": "string"
        },
        "taskId": {
          "$ref": "#/$defs/text"
        },
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "stateFingerprint": {
          "$ref": "#/$defs/text"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "receiptDigest": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
