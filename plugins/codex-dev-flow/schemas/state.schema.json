{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Dev Flow task state V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "revision",
    "risk",
    "configSnapshot",
    "policySnapshot",
    "issues",
    "reviewCycle",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "taskId": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "shape": {
      "$ref": "#/$defs/shapeState"
    },
    "contractDigest": {
      "$ref": "#/$defs/text"
    },
    "verificationRequirements": {
      "$ref": "#/$defs/verificationRequirements"
    },
    "resumeTo": {
      "$ref": "#/$defs/resumeTarget"
    },
    "configSnapshot": {
      "type": "object"
    },
    "policySnapshot": {
      "type": "object"
    },
    "issues": {
      "type": "array"
    },
    "reviewCycle": {
      "type": "integer",
      "minimum": 0
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/transitionEvent"
          },
          {
            "$ref": "#/$defs/workflowEvent"
          }
        ]
      }
    },
    "historySummary": {
      "$ref": "#/$defs/historySummary"
    },
    "activeArtifact": {
      "$ref": "#/$defs/activeArtifact"
    },
    "activeWorktree": {
      "$ref": "#/$defs/activeWorktree"
    },
    "contextCapsule": {
      "type": "object"
    },
    "routingSnapshot": {
      "type": "object"
    },
    "routingPolicyVersion": {
      "$ref": "#/$defs/text"
    },
    "routingDecisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "intake": {
      "$ref": "#/$defs/intakeState"
    },
    "benchmarkEnabled": {
      "type": "boolean"
    },
    "resumeReason": {
      "$ref": "#/$defs/text"
    },
    "planApproval": {
      "$ref": "#/$defs/planApprovalReceipt"
    },
    "verificationReceipt": {
      "$ref": "#/$defs/verificationReceipt"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["resumeTo", "resumeReason"],
        "properties": {
          "resumeTo": {
            "$ref": "#/$defs/resumeTarget"
          },
          "resumeReason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "blocked"
            }
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["resumeTo"]
            },
            {
              "required": ["resumeReason"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_approval"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["contractDigest"],
        "properties": {
          "contractDigest": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "finished"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["verificationReceipt"],
        "properties": {
          "verificationReceipt": {
            "$ref": "#/$defs/verificationReceipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "discovering",
              "awaiting_profile_choice",
              "planning",
              "awaiting_intake_decision",
              "awaiting_approval",
              "executing",
              "validating",
              "resolving_build",
              "reviewing",
              "resolving_assure",
              "verifying",
              "finished"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["shape"],
        "properties": {
          "shape": {
            "$ref": "#/$defs/shapeState"
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+~=-]*$"
    },
    "status": {
      "enum": [
        "new",
        "intaking",
        "discovering",
        "awaiting_profile_choice",
        "planning",
        "awaiting_intake_decision",
        "awaiting_approval",
        "executing",
        "validating",
        "resolving_build",
        "reviewing",
        "resolving_assure",
        "verifying",
        "blocked",
        "cancelled",
        "failed",
        "finished"
      ]
    },
    "resumeTarget": {
      "enum": [
        "intaking",
        "discovering",
        "awaiting_profile_choice",
        "planning",
        "awaiting_intake_decision",
        "awaiting_approval",
        "executing",
        "validating",
        "resolving_build",
        "reviewing",
        "resolving_assure",
        "verifying"
      ]
    },
    "historyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "task",
            "shape",
            "artifact",
            "worktree",
            "context-capsule",
            "context",
            "issue",
            "correction",
            "gate",
            "scope",
            "evidence",
            "receipt",
            "command",
            "criterion",
            "decision",
            "policy",
            "config",
            "git",
            "symbol"
          ]
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "fingerprint": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "workflowEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "type", "refs"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string"
        },
        "type": {
          "enum": [
            "task.created",
            "task.blocked",
            "task.resumed",
            "gate.recorded",
            "scope.approved",
            "artifact.recorded",
            "issue.recorded",
            "correction.recorded",
            "context.updated",
            "intake.question_recorded",
            "intake.answer_recorded",
            "intake.checkpoint",
            "advance.rejected",
            "intake.reopened",
            "discovery.target_recorded",
            "discovery.evidence_recorded",
            "discovery.completed",
            "profile.choice_requested",
            "profile.choice_recorded",
            "decision.escalated",
            "contract.projected",
            "projection.reconciliation_requested",
            "evidence.invalidated",
            "shape.checkpoint"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/historyReference"
          }
        }
      }
    },
    "transitionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "type", "from", "to", "revision", "sourceFingerprint"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string"
        },
        "type": {
          "const": "state.transition"
        },
        "from": {
          "$ref": "#/$defs/status"
        },
        "to": {
          "$ref": "#/$defs/status"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/text"
        },
        "terminalSource": {
          "$ref": "#/$defs/status"
        },
        "terminalResumeTo": {
          "$ref": "#/$defs/resumeTarget"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "guardEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "gateDecision": {
          "$ref": "#/$defs/gateDecision"
        }
      }
    },
    "historySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removedCount",
        "firstSequence",
        "lastSequence",
        "firstAt",
        "lastAt",
        "typeCounts"
      ],
      "properties": {
        "removedCount": {
          "type": "integer",
          "minimum": 1
        },
        "firstSequence": {
          "type": "integer",
          "minimum": 1
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 1
        },
        "firstAt": {
          "type": "string"
        },
        "lastAt": {
          "type": "string"
        },
        "typeCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lastTransition": {
          "type": "object"
        }
      }
    },
    "activeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "ownerRef", "fingerprint"],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "ownerRef": {
          "$ref": "#/$defs/text"
        },
        "fingerprint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "activeWorktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktreeRef", "gitFingerprint"],
      "properties": {
        "worktreeRef": {
          "$ref": "#/$defs/text"
        },
        "gitFingerprint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "verificationRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceDigest",
        "requirementsDigest",
        "criterionIds",
        "mandatoryCheckIds"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sourceDigest": {
          "$ref": "#/$defs/text"
        },
        "requirementsDigest": {
          "$ref": "#/$defs/text"
        },
        "criterionIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "mandatoryCheckIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        }
      }
    },
    "intakeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "brief",
        "decisions",
        "answeredDecisionKeys",
        "invalidations",
        "contradictions",
        "semanticComplete",
        "deterministicComplete",
        "checkpointDue",
        "semanticRetryCount",
        "metrics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "brief": {
          "$ref": "#/$defs/intakeBrief"
        },
        "activeQuestion": {
          "type": "object"
        },
        "decisions": {
          "type": "array"
        },
        "answeredDecisionKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidations": {
          "type": "array"
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semanticComplete": {
          "type": "boolean"
        },
        "deterministicComplete": {
          "type": "boolean"
        },
        "checkpointDue": {
          "type": "boolean"
        },
        "semanticRetryCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockedReason": {
          "enum": ["semantic_output_invalid", "answer_required"]
        },
        "metrics": {
          "$ref": "#/$defs/intakeMetrics"
        }
      }
    },
    "intakeBrief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "risk", "provenance", "technicalUnknowns"],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "objective": {
          "type": "string"
        },
        "successSignal": {
          "type": "object"
        },
        "risk": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "provenance": {
          "type": "object"
        },
        "successValidator": {
          "type": "string"
        },
        "successGuardrails": {
          "type": "array"
        },
        "determiningConstraints": {
          "type": "array"
        },
        "affectedUsers": {
          "type": "array"
        },
        "motivation": {
          "type": "string"
        },
        "urgency": {
          "type": "string"
        },
        "scopeBoundaries": {
          "type": "array"
        },
        "technicalUnknowns": {
          "type": "array"
        }
      }
    },
    "shapeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "risk",
        "intakeBriefRef",
        "discoveryTargets",
        "evidence",
        "sourceFingerprints",
        "decisionEscalations",
        "dependencyGraph",
        "invalidations",
        "budget",
        "semanticRetryCounts",
        "evaluatorReceipts"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "risk": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "intakeBriefRef": {
          "$ref": "#/$defs/text"
        },
        "discoveryTargets": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "sourceFingerprints": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "decisionEscalations": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "activeEscalationId": {
          "$ref": "#/$defs/text"
        },
        "preparationProfileChoice": {
          "type": "object"
        },
        "contract": {
          "type": "object"
        },
        "projection": {
          "type": "object"
        },
        "dependencyGraph": {
          "type": "object"
        },
        "invalidations": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "budget": {
          "type": "object"
        },
        "semanticRetryCounts": {
          "type": "object"
        },
        "evaluatorReceipts": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "intakeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelCalls",
        "questionsAsked",
        "questionsAvoided",
        "distinctQuestions",
        "recommendationsAccepted",
        "recommendationsModified",
        "zeroQuestionPath",
        "lateReopenings"
      ],
      "properties": {
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "questionsAsked": {
          "type": "integer",
          "minimum": 0
        },
        "questionsAvoided": {
          "type": "integer",
          "minimum": 0
        },
        "distinctQuestions": {
          "type": "integer",
          "minimum": 0
        },
        "recommendationsAccepted": {
          "type": "integer",
          "minimum": 0
        },
        "recommendationsModified": {
          "type": "integer",
          "minimum": 0
        },
        "lateReopenings": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "latencyMs": {
          "type": "integer",
          "minimum": 0
        },
        "zeroQuestionPath": {
          "type": "boolean"
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decision",
        "actor",
        "decidedAt",
        "taskId",
        "artifactId",
        "stateRevision",
        "stateFingerprint",
        "contractDigest",
        "receiptDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "decision": {
          "enum": ["approved", "change_requested", "rejected"]
        },
        "actor": {
          "const": "user"
        },
        "decidedAt": {
          "type": "string"
        },
        "taskId": {
          "$ref": "#/$defs/text"
        },
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "stateFingerprint": {
          "$ref": "#/$defs/text"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "instructionRef": {
          "$ref": "#/$defs/ref"
        },
        "receiptDigest": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "planApprovalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decision",
        "actor",
        "decidedAt",
        "taskId",
        "artifactId",
        "stateRevision",
        "stateFingerprint",
        "contractDigest",
        "receiptDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "decision": {
          "const": "approved"
        },
        "actor": {
          "const": "user"
        },
        "decidedAt": {
          "type": "string"
        },
        "taskId": {
          "$ref": "#/$defs/text"
        },
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "stateFingerprint": {
          "$ref": "#/$defs/text"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "receiptDigest": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "verificationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "verifiedAt",
        "taskId",
        "contractDigest",
        "stateRevision",
        "stateFingerprint",
        "requirementsDigest",
        "criterionIds",
        "validationIds",
        "evidenceRefs",
        "receiptDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "verifiedAt": {
          "type": "string"
        },
        "taskId": {
          "$ref": "#/$defs/text"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "stateFingerprint": {
          "$ref": "#/$defs/text"
        },
        "requirementsDigest": {
          "$ref": "#/$defs/text"
        },
        "criterionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "validationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "receiptDigest": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
