{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "custom.regex"],
  "ignorePaths": ["**/node_modules/**", "test/fixtures/**", "docs/**", ".worktrees/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.bun-version$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "bun",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.node-version$/"],
      "matchStrings": ["(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.buildkite/pipeline\\.yml$/"],
      "matchStrings": ["DAGGER_VERSION:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "dagger/dagger",
      "packageNameTemplate": "https://github.com/dagger/dagger.git",
      "datasourceTemplate": "git-tags",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.buildkite/pipeline\\.yml$/"],
      "matchStrings": ["RENOVATE_VERSION:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".node-version"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["*"],
      "groupName": "weekly dependencies"
    }
  ]
}
