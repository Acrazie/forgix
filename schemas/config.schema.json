{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Dev Flow configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pullRequest": {
          "type": "string",
          "enum": ["optional", "required"]
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "required"]
        }
      }
    },
    "merge": {
      "type": "string",
      "const": "never"
    }
  }
}
