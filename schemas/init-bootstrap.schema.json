{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forgix init bootstrap manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "harnesses", "rules", "hooks", "gitignore", "worktreeInclude"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "harnesses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["codex", "claude", "antigravity"]
      }
    },
    "configPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string",
          "enum": ["auto", "codex", "claude", "antigravity"]
        },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["auto", "required"]
            }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["worktree", "dagger", "auto"]
            },
            "assureRunner": {
              "type": "string",
              "enum": ["worktree", "dagger", "auto"]
            }
          }
        },
        "integrations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plugins": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/integrationId" }
            },
            "skills": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/integrationId" }
            }
          }
        },
        "subscription": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "string",
              "enum": ["auto", "plus", "pro_5x", "pro_20x"]
            },
            "planOverride": {
              "type": "string",
              "enum": ["plus", "pro_5x", "pro_20x"]
            },
            "multiplierOverride": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "quota": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "warningPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                "criticalPercent": { "type": "number", "minimum": 0, "maximum": 100 },
                "unknownPolicy": { "type": "string", "const": "conservative" }
              }
            },
            "modelAllowlist": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"]
              }
            },
            "modelCosts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gpt-5.6-luna": { "$ref": "#/$defs/modelCost" },
                "gpt-5.6-terra": { "$ref": "#/$defs/modelCost" },
                "gpt-5.6-sol": { "$ref": "#/$defs/modelCost" }
              }
            }
          }
        },
        "roadmap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adapter": {
              "type": "string",
              "enum": ["local", "github", "entire"]
            },
            "requirePlanAudit": {
              "type": "boolean"
            },
            "mode": {
              "type": "string",
              "enum": ["local", "github"]
            },
            "project": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "owner": { "type": "string", "minLength": 1 },
                "number": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "minLength": 1 },
                "productVisionPath": { "type": "string", "minLength": 1 }
              }
            },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "minLength": 1 },
                "risk": { "type": "string", "minLength": 1 },
                "priority": { "type": "string", "minLength": 1 },
                "wave": { "type": "string", "minLength": 1 }
              }
            },
            "autonomous": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "maxRisk": { "enum": ["low", "medium"] },
                "defaultParallel": { "type": "integer", "minimum": 1, "maximum": 8 },
                "worktreeBaseBranch": { "type": "string", "minLength": 1 },
                "requireExistingWorktree": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/factoryRule" } }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": ["items"],
        "properties": { "items": { "type": "array", "minItems": 1 } }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/factoryAgent" } }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": ["items"],
        "properties": { "items": { "type": "array", "minItems": 1 } }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "items": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/factorySkill" } }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "required": ["items"],
        "properties": { "items": { "type": "array", "minItems": 1 } }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "enforcement": {
          "type": "string",
          "enum": ["balanced", "strict", "warn"]
        }
      }
    },
    "gitignore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "extraEntries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\u0000]+$"
          }
        }
      }
    },
    "worktreeInclude": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "entries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n\\u0000]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "factorySlug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "safeRelativeGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\u0000]+$"
    },
    "factoryRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/factorySlug" },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "globs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeRelativeGlob" }
        },
        "alwaysApply": { "type": "boolean" },
        "enforce": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protectedSurfaces": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/safeRelativeGlob" }
            },
            "blockedCommands": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["pattern", "reason"],
                "properties": {
                  "pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
                }
              }
            },
            "escapeHatchPatterns": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "pattern"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "pattern": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            }
          }
        },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "factoryAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/factorySlug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "role": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "model": { "type": "string", "minLength": 1, "maxLength": 120 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "factorySkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "content"],
      "properties": {
        "id": { "$ref": "#/$defs/factorySlug" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "integrationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?::[A-Za-z0-9][A-Za-z0-9._/-]*)?$"
    },
    "modelCost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "rateVersion": { "type": "string", "minLength": 1 },
        "inputCreditsPerMillion": { "type": "number", "minimum": 0 },
        "cachedInputCreditsPerMillion": { "type": "number", "minimum": 0 },
        "outputCreditsPerMillion": { "type": "number", "minimum": 0 }
      }
    }
  }
}
