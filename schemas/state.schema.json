{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Forgix task state V6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "status",
    "revision",
    "risk",
    "design",
    "configSnapshot",
    "policySnapshot",
    "issues",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "const": 6
    },
    "taskId": {
      "$ref": "#/$defs/text"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "risk": {
      "enum": ["low", "medium", "high", "critical"]
    },
    "shape": {
      "$ref": "#/$defs/shapeState"
    },
    "contractDigest": {
      "$ref": "#/$defs/text"
    },
    "assurance": {
      "type": "object",
      "properties": {
        "externalArtifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "completionIndex": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "receipt": {
          "type": "object",
          "properties": {
            "schemaVersion": { "enum": [1, 2] },
            "taskId": { "type": "string" },
            "contractDigest": { "type": "string" },
            "verifiedSnapshotFingerprint": { "type": "string" },
            "evidenceIndexDigest": { "type": "string" },
            "completedAt": { "type": "string" },
            "receiptDigest": { "type": "string" },
            "worktreeDigest": { "type": "string" },
            "observedSnapshotFingerprint": { "type": "string" },
            "artifactDigests": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "evidenceIndex": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "verifierKind": {
                "$ref": "#/$defs/verifierKind"
              }
            }
          }
        }
      }
    },
    "design": {
      "type": "object"
    },
    "resumeTo": {
      "$ref": "#/$defs/resumeTarget"
    },
    "configSnapshot": {
      "type": "object"
    },
    "policySnapshot": {
      "type": "object"
    },
    "issues": {
      "type": "array"
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/transitionEvent"
          },
          {
            "$ref": "#/$defs/workflowEvent"
          }
        ]
      }
    },
    "historySummary": {
      "$ref": "#/$defs/historySummary"
    },
    "activeArtifact": {
      "$ref": "#/$defs/activeArtifact"
    },
    "activeWorktree": {
      "$ref": "#/$defs/activeWorktree"
    },
    "contextCapsule": {
      "type": "object"
    },
    "routingSnapshot": {
      "type": "object"
    },
    "routingPolicyVersion": {
      "$ref": "#/$defs/text"
    },
    "routingDecisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resumeReason": {
      "$ref": "#/$defs/text"
    },
    "planApproval": {
      "$ref": "#/$defs/planApprovalReceipt"
    },
    "contractReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rounds", "accepted"],
      "properties": {
        "version": { "const": 1 },
        "capsule": { "type": "object" },
        "rounds": { "type": "array", "maxItems": 5, "items": { "type": "object" } },
        "accepted": { "type": "array", "maxItems": 160, "items": { "type": "object" } },
        "buildProof": { "type": "object" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["resumeTo", "resumeReason"],
        "properties": {
          "resumeTo": {
            "$ref": "#/$defs/resumeTarget"
          },
          "resumeReason": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "not": {
              "const": "blocked"
            }
          }
        },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": ["resumeTo"]
            },
            {
              "required": ["resumeReason"]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_approval"
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["contractDigest"],
        "properties": {
          "contractDigest": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "discovering",
              "awaiting_shape_decision",
              "awaiting_profile_choice",
              "planning",
              "awaiting_intake_decision",
              "awaiting_approval",
              "executing",
              "assuring"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["shape"],
        "properties": {
          "shape": {
            "$ref": "#/$defs/shapeState"
          }
        }
      }
    }
  ],
  "$defs": {
    "verifierKind": {
      "enum": [
        "command",
        "runtime-evidence",
        "tla-tlc",
        "lean4",
        "model-inspection",
        "user-observation"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#@+~=-]*$"
    },
    "status": {
      "enum": [
        "new",
        "intaking",
        "discovering",
        "awaiting_shape_decision",
        "awaiting_profile_choice",
        "planning",
        "awaiting_intake_decision",
        "awaiting_approval",
        "executing",
        "assuring",
        "blocked",
        "cancelled",
        "failed"
      ]
    },
    "resumeTarget": {
      "enum": [
        "intaking",
        "discovering",
        "awaiting_shape_decision",
        "awaiting_profile_choice",
        "planning",
        "awaiting_intake_decision",
        "awaiting_approval",
        "executing",
        "assuring"
      ]
    },
    "historyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": [
            "task",
            "shape",
            "artifact",
            "worktree",
            "context-capsule",
            "context",
            "issue",
            "correction",
            "gate",
            "scope",
            "evidence",
            "receipt",
            "command",
            "criterion",
            "decision",
            "policy",
            "config",
            "git",
            "symbol"
          ]
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "fingerprint": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "workflowEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "type", "refs"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string"
        },
        "type": {
          "enum": [
            "task.created",
            "task.blocked",
            "task.resumed",
            "gate.recorded",
            "scope.approved",
            "artifact.recorded",
            "issue.recorded",
            "correction.recorded",
            "context.updated",
            "advance.rejected",
            "discovery.target_recorded",
            "discovery.evidence_recorded",
            "discovery.completed",
            "profile.choice_requested",
            "profile.choice_recorded",
            "design.question_recorded",
            "design.answer_recorded",
            "design.invalidated",
            "contract.projected",
            "projection.reconciliation_requested",
            "evidence.invalidated",
            "shape.checkpoint",
            "assurance.evidence_recorded",
            "assurance.evidence_invalidated",
            "assurance.issue_resolved",
            "assurance.human_observation_requested",
            "assure.completed"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/historyReference"
          }
        },
        "receiptDigest": { "type": "string" },
        "contractDigest": { "type": "string" },
        "verifiedSnapshotFingerprint": { "type": "string" },
        "completionIndex": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "receiptVersion": { "enum": [1, 2] }
      }
    },
    "transitionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "type", "from", "to", "revision", "sourceFingerprint"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "type": "string"
        },
        "type": {
          "const": "state.transition"
        },
        "from": {
          "$ref": "#/$defs/status"
        },
        "to": {
          "$ref": "#/$defs/status"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sourceFingerprint": {
          "$ref": "#/$defs/text"
        },
        "terminalSource": {
          "$ref": "#/$defs/status"
        },
        "terminalResumeTo": {
          "$ref": "#/$defs/resumeTarget"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "guardEvidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "gateDecision": {
          "$ref": "#/$defs/gateDecision"
        }
      }
    },
    "historySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removedCount",
        "firstSequence",
        "lastSequence",
        "firstAt",
        "lastAt",
        "typeCounts"
      ],
      "properties": {
        "removedCount": {
          "type": "integer",
          "minimum": 1
        },
        "firstSequence": {
          "type": "integer",
          "minimum": 1
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 1
        },
        "firstAt": {
          "type": "string"
        },
        "lastAt": {
          "type": "string"
        },
        "typeCounts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "lastTransition": {
          "type": "object"
        }
      }
    },
    "activeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "ownerRef", "fingerprint"],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "ownerRef": {
          "$ref": "#/$defs/text"
        },
        "fingerprint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "activeWorktree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktreeRef", "gitFingerprint"],
      "properties": {
        "worktreeRef": {
          "$ref": "#/$defs/text"
        },
        "gitFingerprint": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "shapeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "risk",
        "productBaselineRef",
        "discoveryTargets",
        "evidence",
        "dependencyGraph"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "risk": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "productBaselineRef": {
          "$ref": "#/$defs/text"
        },
        "discoveryTargets": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "sourceFingerprints": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "technicalDecisions": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "activeTechnicalDecisionId": {
          "$ref": "#/$defs/text"
        },
        "preparationProfileChoice": {
          "type": "object"
        },
        "contract": {
          "type": "object",
          "properties": {
            "schemaVersion": { "enum": [1, 2] },
            "approvedProtectedPaths": {
              "type": "array",
              "maxItems": 4096,
              "items": { "$ref": "#/$defs/text" }
            },
            "approvedEscapeHatches": {
              "type": "array",
              "maxItems": 4096,
              "items": { "$ref": "#/$defs/text" }
            },
            "planDesign": {
              "type": "object",
              "additionalProperties": false,
              "required": ["objective", "choices"],
              "properties": {
                "objective": { "$ref": "#/$defs/text" },
                "sourceFingerprint": { "$ref": "#/$defs/text" },
                "choices": {
                  "type": "array",
                  "maxItems": 4096,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["decisionId", "optionId", "summary"],
                    "properties": {
                      "decisionId": { "$ref": "#/$defs/text" },
                      "optionId": { "$ref": "#/$defs/text" },
                      "summary": { "$ref": "#/$defs/text" },
                      "rationale": { "$ref": "#/$defs/text" }
                    }
                  }
                }
              }
            },
            "assuranceContract": {
              "type": "object",
              "properties": {
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "$ref": "#/$defs/verifierKind"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "projection": {
          "type": "object"
        },
        "dependencyGraph": {
          "type": "object"
        },
        "invalidations": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object"
          }
        },
        "budget": {
          "type": "object"
        },
        "semanticRetryCounts": {
          "type": "object"
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decision",
        "actor",
        "decidedAt",
        "taskId",
        "artifactId",
        "stateRevision",
        "stateFingerprint",
        "contractDigest",
        "receiptDigest"
      ],
      "if": {
        "properties": { "schemaVersion": { "const": 2 } }
      },
      "then": {
        "required": ["worktreeDigest"],
        "properties": {
          "worktreeDigest": true,
          "decision": { "const": "approved" },
          "actor": { "const": "user" },
          "issueRef": false
        }
      },
      "else": { "properties": { "worktreeDigest": false } },
      "properties": {
        "schemaVersion": {
          "enum": [1, 2]
        },
        "worktreeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "enum": ["approved", "change_requested", "rejected"]
        },
        "actor": {
          "enum": ["user", "autonomous_policy"]
        },
        "issueRef": {
          "type": "string",
          "pattern": "^(([a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+)?#[1-9][0-9]*|local:[a-z0-9][a-z0-9._-]{0,63})$"
        },
        "decidedAt": {
          "type": "string"
        },
        "taskId": {
          "$ref": "#/$defs/text"
        },
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "stateFingerprint": {
          "$ref": "#/$defs/text"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "instructionRef": {
          "$ref": "#/$defs/ref"
        },
        "receiptDigest": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "planApprovalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "decision",
        "actor",
        "decidedAt",
        "taskId",
        "artifactId",
        "stateRevision",
        "stateFingerprint",
        "contractDigest",
        "receiptDigest"
      ],
      "if": {
        "properties": { "schemaVersion": { "const": 2 } }
      },
      "then": {
        "required": ["worktreeDigest"],
        "properties": {
          "worktreeDigest": true,
          "decision": { "const": "approved" },
          "actor": { "const": "user" },
          "issueRef": false
        }
      },
      "else": { "properties": { "worktreeDigest": false } },
      "properties": {
        "schemaVersion": {
          "enum": [1, 2]
        },
        "worktreeDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "const": "approved"
        },
        "actor": {
          "enum": ["user", "autonomous_policy"]
        },
        "issueRef": {
          "type": "string",
          "pattern": "^(([a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+)?#[1-9][0-9]*|local:[a-z0-9][a-z0-9._-]{0,63})$"
        },
        "decidedAt": {
          "type": "string"
        },
        "taskId": {
          "$ref": "#/$defs/text"
        },
        "artifactId": {
          "$ref": "#/$defs/text"
        },
        "stateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "stateFingerprint": {
          "$ref": "#/$defs/text"
        },
        "contractDigest": {
          "$ref": "#/$defs/text"
        },
        "receiptDigest": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
